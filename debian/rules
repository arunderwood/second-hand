#!/usr/bin/make -f

%:
	dh $@

# build-pex.sh needs uv on PATH, which is not a Debian package: CI installs it
# with astral-sh/setup-uv before running dpkg-buildpackage.
override_dh_auto_build:
	./scripts/build-pex.sh

override_dh_auto_install:
	install -D -m 755 dist/second-hand.pex \
		debian/second-hand/usr/lib/second-hand/second-hand.pex

# Skip dwz compression - pre-compiled binaries from wheels don't have debug sections
override_dh_dwz:
