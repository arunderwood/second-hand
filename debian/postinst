#!/bin/sh
set -e

case "$1" in
    configure)
        # Static system group guarding the reader's snapshot file. Static,
        # not dynamic: the web unit joins it via SupplementaryGroups=, which
        # must resolve at unit start. postrm leaves it behind on purpose —
        # groups are cheap and removal races with running units.
        # groupadd, not addgroup: adduser is no longer installed by default
        # on Ubuntu 26.04, while groupadd ships in the essential passwd
        # package everywhere.
        getent group second-hand-data >/dev/null || \
            groupadd --system second-hand-data
        ;;
esac

#DEBHELPER#
