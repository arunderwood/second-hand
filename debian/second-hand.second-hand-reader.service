[Unit]
Description=second-hand chronyd client-data reader
Documentation=https://github.com/arunderwood/second-hand
# chronyd.service is an [Install] Alias= of chrony.service on Debian, so it
# resolves only while chrony is enabled.
After=network.target chrony.service chronyd.service
Wants=chrony.service

[Service]
Type=simple
# _chrony owns chronyd's control socket directory (/run/chrony, 0750): running
# as that user is the whole privilege this feature needs, and it stays out of
# the network-facing web service (FR-010). The group guards the snapshot file,
# nothing else.
User=_chrony
Group=second-hand-data
ExecStart=/usr/bin/python3 /usr/lib/second-hand/second-hand.pex
Environment=PEX_MODULE=second_hand.reader
# Shared with second-hand.service: one off switch turns off both (FR-016).
EnvironmentFile=-/etc/default/second-hand
Restart=on-failure
RestartSec=5

# The snapshot's home: 0750 _chrony:second-hand-data, wiped when the unit
# stops, so a disabled reader leaves no client data behind. UMask 0027 lands
# the file itself at 0640 — the web service reads it through the group and
# cannot write it.
RuntimeDirectory=second-hand-reader
RuntimeDirectoryMode=0750
UMask=0027

# The service user has no home, so pex's default PEX_ROOT is unwritable and
# the pex would re-extract to a temporary directory on every start.
CacheDirectory=second-hand-reader
Environment=PEX_ROOT=/var/cache/second-hand-reader

# Security hardening: the web unit's block (FR-014), minus what a process with
# no listener needs. `systemd-analyze security` has its own ceiling for this
# unit in the .deb integration tests.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
# @system-service already permits the fork/exec the chronyc subprocess needs.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# chronyc talks to chronyd over its Unix socket only; the reader needs no
# network of any kind, inbound or outbound.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# No MemoryDenyWriteExecute, matching the web unit: the shared pex bundles
# cffi-based pychrony, whose import machinery is exercised at extraction.

[Install]
WantedBy=multi-user.target
