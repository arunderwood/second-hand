[Unit]
Description=second-hand Chrony Dashboard
Documentation=https://github.com/arunderwood/second-hand
# chronyd.service is an [Install] Alias= of chrony.service on Debian, so it
# resolves only while chrony is enabled.
After=network.target chrony.service chronyd.service
Wants=chrony.service

[Service]
Type=simple
User=second-hand
Group=second-hand
ExecStart=/usr/bin/python3 /usr/lib/second-hand/second-hand.pex
Restart=on-failure
RestartSec=5
Environment=SECOND_HAND_HOST=0.0.0.0
Environment=SECOND_HAND_PORT=8000

# The service user has no home, so pex's default PEX_ROOT is unwritable and the
# pex would re-extract to a temporary directory on every start.
CacheDirectory=second-hand
Environment=PEX_ROOT=/var/cache/second-hand

# Security hardening. `systemd-analyze security` scores this unit 1.5; the .deb
# integration tests enforce a ceiling so the score cannot drift back up.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The dashboard runs as a non-root user and binds port 8000, so it needs no
# capabilities whatsoever.
CapabilityBoundingSet=

# chronyd is reached over UDP, but AF_UNIX stays: glibc talks to
# systemd-resolved over a Unix socket, which the GeoIP lookups depend on.
# Excluding it saves 0.1 of exposure and would break name resolution on any
# host using resolved.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No MemoryDenyWriteExecute: pychrony is cffi-based, and libffi closures need
# writable-executable pages. Adding it breaks the service at runtime only.

[Install]
WantedBy=multi-user.target
